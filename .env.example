# Deployment safety. Every side-effect switch is fail-closed.
APP_ENVIRONMENT=test
STRIPE_WEBHOOKS_ENABLED=false
GOOGLE_PLAY_WEBHOOKS_ENABLED=false
APPLE_WEBHOOKS_ENABLED=false
OUTBOX_PROCESSING_ENABLED=false
AD_CONVERSIONS_ENABLED=false
LEGACY_FULFILLMENT_ENABLED=false
SUBSCRIPTION_CANCELLATION_ENABLED=false
ACCOUNT_DELETION_PROCESSING_ENABLED=false
STRIPE_MUTATIONS_ENABLED=false
APP_CHECK_ENFORCEMENT_ENABLED=false
SUBSCRIPTION_RECONCILIATION_ENABLED=false
CLOUD_STORAGE_MONITORING_ENABLED=false
DEVICE_SIGN_IN_ENABLED=false
DEVICE_SIGN_IN_CLEANUP_ENABLED=false

# Firebase Admin (use a separate Firebase test project for staging)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=

# Android builds do not run on Netlify. Inject this through the Android build
# environment or the Android project's untracked local.properties file.
WONDERLANG_ENTITLEMENTS_FIREBASE_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MOBILE_MONTHLY=
STRIPE_PRICE_POLYGLOT_PERMANENT=
STRIPE_PRICE_PREMIUM_LIFETIME=
STRIPE_COUPON_LEGACY_DESKTOP_50=
STRIPE_SUCCESS_URL=https://wonderlang.net/account?checkout=success
STRIPE_CANCEL_URL=https://wonderlang.net/account?checkout=canceled
STRIPE_PORTAL_RETURN_URL=https://wonderlang.net/account

# Service controls
PUBLIC_APP_ORIGIN=https://wonderlang.net
CLOUD_STORAGE_DAILY_GROWTH_ALERT_BYTES=524288000
KEY_INVENTORY_DEFAULT_LOW_STOCK_THRESHOLD=10
# Optional per-tab overrides, for example: {"Steam Japanese":20,"Itch English":15}
KEY_INVENTORY_LOW_STOCK_THRESHOLDS={}

# Existing key automation integrations
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
MAILERLITE_API_TOKEN=
ML_GROUPS_ALL=
ML_GROUPS_POLY_STEAM=
ML_GROUPS_POLY_ITCH=
ML_FIELD_STEAM_KEY=steam_key
ML_FIELD_ITCH_KEY=itch_key
ML_FIELD_EXTRA_STEAM_KEY=extra_steam_key
ML_FIELD_EXTRA_ITCH_KEY=extra_itch_link

# Ad server events. Renewals are intentionally excluded by policy.
META_PIXEL_ID=
META_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v23.0
META_TEST_EVENT_CODE=
TIKTOK_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=
TIKTOK_TEST_EVENT_CODE=

# Google Play Developer API / RTDN
GOOGLE_PLAY_PACKAGE_NAME=com.wonderlang.app
GOOGLE_PLAY_MONTHLY_PRODUCT_ID=wonderlangmonthly
GOOGLE_PLAY_POLYGLOT_PRODUCT_ID=wonderlangfull
GOOGLE_PLAY_RTDN_AUDIENCE=
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=

# AES-256-GCM key ring for encrypted Google Play subscription tokens. Generate
# a distinct 32-byte key per environment and store only this JSON in Netlify.
# Example structure (the value below is deliberately not a usable key):
# PROVIDER_TOKEN_ENCRYPTION_KEYS={"current":"staging-2026-08","keys":{"staging-2026-08":"<base64-encoded-32-byte-key>"}}
PROVIDER_TOKEN_ENCRYPTION_KEYS=

# Apple App Store Server API / Notifications V2
APPLE_BUNDLE_ID=
APPLE_APP_ID=
APPLE_MONTHLY_PRODUCT_ID=wonderlangmonthly
APPLE_POLYGLOT_PRODUCT_ID=wonderlangfull
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_ENVIRONMENT=Sandbox
APPLE_ROOT_CA_G2_BASE64=
APPLE_ROOT_CA_G3_BASE64=
